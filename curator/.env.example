# Worker runs independently from Strapi and Next.js.
CURATOR_INSTANCE_KIND=dev
CURATOR_ENABLED=false
CURATOR_WRITE_DRAFTS=false
# Optional preview-only limits (do not change live 45-day window or 3-item batch)
CURATOR_PREVIEW_DAYS=120
CURATOR_PREVIEW_LIMIT=6
# Manual AI preview: free provider+Redis quotas, no CMS writing, max 2 drafts
CURATOR_AI_PREVIEW_LIMIT=1
CURATOR_AI_PREVIEW_DAYS=45
CURATOR_GLOBAL_MAX_CALLS=30
CURATOR_WINDOW_MS=86400000
CURATOR_MAX_ATTEMPTS=4
CURATOR_ATTEMPT_TIMEOUT_MS=15000
CURATOR_MAX_OUTPUT_TOKENS=1600
CURATOR_COOLDOWN_MS=60000
CURATOR_MAX_COOLDOWN_MS=86400000
CURATOR_REDIS_URL=redis://redis:6379
CURATOR_CMS_URL=http://cms:1337
CURATOR_STRAPI_DRAFT_TOKEN=

# Only Free OpenRouter models: openrouter/free or ending in :free
CURATOR_OPENROUTER_API_KEY=
CURATOR_OPENROUTER_MODEL=openrouter/free
# Nemotron 3.5 Super VL free disables reasoning by default for short editorial JSON.
# To override on a specific supported model, uncomment:
# CURATOR_OPENROUTER_REASONING_ENABLED=true
CURATOR_OPENROUTER_MAX_CALLS=10

# Optional backup: only enable after confirming free-tier-only access and disabling paid billing.
CURATOR_GEMINI_API_KEY=
CURATOR_GEMINI_MODEL=
CURATOR_GEMINI_FREE_TIER_CONFIRMED=false
CURATOR_GEMINI_MAX_CALLS=10
CURATOR_GROQ_API_KEY=
CURATOR_GROQ_MODEL=
CURATOR_GROQ_FREE_TIER_CONFIRMED=false
CURATOR_GROQ_MAX_CALLS=10

# Optional local Ollama fallback; requires a private reachable Ollama instance.
CURATOR_OLLAMA_MODEL=
CURATOR_OLLAMA_URL=http://ollama:11434
