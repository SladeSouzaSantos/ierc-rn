# Recorrência financeira — EXEMPLO, NUNCA ativar sem aprovação do IERC-RN.
# Copie APENAS as chaves aprovadas ao env privado do portal DEV/PROD.
# Este arquivo não armazena tokens; o checkout é hospedado no provedor.
IERCRN_DONATIONS_RECURRING_ENABLED=false
IERCRN_DONATIONS_RECEIVER_VERIFIED=false
IERCRN_DONATIONS_GATEWAY=asaas
IERCRN_DONATIONS_RECEIVER_CNPJ=08049504000108
# Chaves permitidas: 20,50,100,custom; métodos: pix,credit.
# custom = link RECURRENT/MONTHLY sem value (doador define o valor no Asaas).
# O valor digitado no portal não é transmitido ao Asaas: confirmar novamente lá.
# Deixe vazio até o IERC obter URLs reais da conta Asaas verificada.
# Não use URLs inventadas, de terceiros, ou links de sandbox na PROD.
IERCRN_DONATIONS_HOSTED_LINKS_JSON='{"pix":{},"credit":{}}'
